<script>
let currentStep = 1;
const totalSteps = 6;
let termoAceito = false;

// ── SCALE INIT ──
function buildScale(containerId, name) {
  const el = document.getElementById(containerId);
  if (!el) return;
  for (let i = 1; i <= 10; i++) {
    const btn = document.createElement('div');
    btn.className = 'snum';
    btn.textContent = i;
    btn.onclick = function() {
      el.querySelectorAll('.snum').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
    };
    el.appendChild(btn);
  }
}
buildScale('scale-sono','sono');
buildScale('scale-stress','stress');
buildScale('scale-energia','energia');

// ── PILL (single select) ──
function pill(el, group) {
  document.querySelectorAll(`.pill[onclick*="'${group}'"]`).forEach(p => p.classList.remove('on'));
  el.classList.add('on');
}

// ── CHECK (multi select) ──
function check(el, group) {
  el.classList.toggle('on');
}

// ── TERMO ──
function toggleTermo() {
  termoAceito = !termoAceito;
  document.getElementById('termoCi').classList.toggle('on', termoAceito);
}

// ── NAVIGATION ──
function updateUI() {
  for (let i = 1; i <= totalSteps; i++) {
    document.getElementById('panel' + i).classList.toggle('active', i === currentStep);
    const dot = document.getElementById('dot' + i);
    const sl = document.getElementById('sl' + i);
    dot.className = 'dot' + (i === currentStep ? ' active' : i < currentStep ? ' done' : '');
    sl.className = 'slabel' + (i === currentStep ? ' active' : i < currentStep ? ' done' : '');
    dot.textContent = i < currentStep ? '✓' : ['✦','◈','◎','◇','❋','→'][i-1];
  }
  document.getElementById('btnBack').style.display = currentStep > 1 ? 'inline-block' : 'none';
  document.getElementById('btnNext').style.display = currentStep < totalSteps ? 'inline-block' : 'none';
  document.getElementById('btnSubmit').style.display = currentStep === totalSteps ? 'inline-block' : 'none';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function next() {
  if (currentStep < totalSteps) { currentStep++; updateUI(); }
}

function back() {
  if (currentStep > 1) { currentStep--; updateUI(); }
}

function goToStep(n) {
  if (n < currentStep) { currentStep = n; updateUI(); }
}

function submit() {
  if (!termoAceito) {
    alert('Por favor, aceite o termo de consentimento para finalizar.');
    return;
  }
  const nome = document.getElementById('nome').value.trim();
  const firstName = nome ? nome.split(' ')[0] : 'cliente';
  document.getElementById('successMsg').innerHTML =
    `Obrigada por compartilhar essas informações, <strong>${firstName}</strong>. Elas são o ponto de partida para um cuidado verdadeiramente personalizado e integrativo.`;
  document.getElementById('formCard').style.display = 'none';
  document.getElementById('progressBar').style.display = 'none';
  document.getElementById('successScreen').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function reset() {
  currentStep = 1;
  termoAceito = false;
  document.getElementById('termoCi').classList.remove('on');
  document.querySelectorAll('input[type=text], input[type=email], input[type=date], textarea')
    .forEach(el => el.value = '');
  document.querySelectorAll('.pill.on').forEach(el => el.classList.remove('on'));
  document.querySelectorAll('.ci.on').forEach(el => el.classList.remove('on'));
  document.querySelectorAll('.snum.on').forEach(el => el.classList.remove('on'));
  document.getElementById('formCard').style.display = 'block';
  document.getElementById('progressBar').style.display = 'block';
  document.getElementById('successScreen').style.display = 'none';
  updateUI();
}

updateUI();
</script>
