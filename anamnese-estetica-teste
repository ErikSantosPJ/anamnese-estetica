<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ficha Anamnética Integrativa — Estética</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#f7f3ef;font-family:'Jost',sans-serif;color:#2c2520;min-height:100vh}

.root{display:flex;flex-direction:column;align-items:center;padding:48px 16px 80px}

/* HEADER */
.header{text-align:center;margin-bottom:48px}
.badge{display:inline-block;font-size:10px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:#a07850;border:1px solid #d4b896;padding:6px 20px;margin-bottom:16px}
.title{font-family:'Cormorant Garamond',serif;font-size:clamp(30px,5vw,50px);font-weight:300;line-height:1.1;color:#2c2520}
.title em{font-style:italic;color:#a07850}
.subtitle{margin-top:10px;font-size:13px;font-weight:300;color:#7a6a60;letter-spacing:.04em}

/* PROGRESS */
.progress{width:100%;max-width:700px;margin-bottom:40px}
.steps{display:flex;justify-content:space-between;position:relative}
.steps::before{content:'';position:absolute;top:18px;left:18px;right:18px;height:1px;background:#e0d4c8;z-index:0}
.step{display:flex;flex-direction:column;align-items:center;gap:7px;z-index:1;cursor:pointer}
.dot{width:36px;height:36px;border-radius:50%;border:1px solid #d4b896;background:#f7f3ef;display:flex;align-items:center;justify-content:center;font-size:13px;color:#c4a882;transition:all .3s}
.dot.active{background:#a07850;border-color:#a07850;color:#fff;box-shadow:0 0 0 4px rgba(160,120,80,.15)}
.dot.done{background:#2c2520;border-color:#2c2520;color:#f7f3ef}
.slabel{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#b0a090;font-weight:500}
.slabel.active{color:#a07850}
.slabel.done{color:#2c2520}

/* CARD */
.card{width:100%;max-width:700px;background:#fff;border:1px solid #e8ddd4;padding:48px;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#c4a882,#a07850,#7a5c38)}

/* SECTION */
.eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.eicon{font-size:18px;color:#a07850}
.enum{font-size:10px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:#c4a882}
.stitle{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:400;color:#2c2520;margin-bottom:4px}
.sdesc{font-size:13px;color:#8a7a70;font-weight:300;margin-bottom:28px;line-height:1.6}
.divider{width:40px;height:1px;background:#d4b896;margin:10px 0 28px}

/* FIELD */
.fg{margin-bottom:26px}
.flabel{display:block;font-size:11px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:#7a6a60;margin-bottom:8px}
.flabel .req{color:#a07850}
.fnote{display:block;font-size:11px;color:#b0a090;font-weight:300;margin-bottom:6px;font-style:italic}
input[type=text],input[type=email],input[type=date],select,textarea{width:100%;background:#faf8f6;border:1px solid #e0d4c8;padding:13px 15px;font-family:'Jost',sans-serif;font-size:14px;font-weight:300;color:#2c2520;outline:none;transition:border-color .2s;-webkit-appearance:none;border-radius:1px}
input:focus,select:focus,textarea:focus{border-color:#a07850;background:#fff}
textarea{min-height:88px;resize:vertical;line-height:1.6}
.sel-wrap{position:relative}
.sel-wrap::after{content:'↓';position:absolute;right:13px;top:50%;transform:translateY(-50%);color:#a07850;font-size:11px;pointer-events:none}

/* GRID */
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
@media(max-width:560px){.row2,.row3{grid-template-columns:1fr}.card{padding:28px 20px}.steps::before{display:none}.slabel{display:none}}

/* CHECKBOXES */
.check-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:7px}
.ci{display:flex;align-items:center;gap:9px;padding:10px 13px;border:1px solid #e8ddd4;background:#faf8f6;cursor:pointer;transition:all .2s;user-select:none}
.ci:hover{border-color:#c4a882;background:#fff}
.ci.on{border-color:#a07850;background:rgba(160,120,80,.06)}
.cbox{width:15px;height:15px;min-width:15px;border:1px solid #d4b896;display:flex;align-items:center;justify-content:center;font-size:9px;color:transparent;transition:all .2s}
.ci.on .cbox{background:#a07850;border-color:#a07850;color:#fff}
.ctext{font-size:13px;font-weight:300;color:#3c3028;line-height:1.3}

/* PILLS */
.pills{display:flex;flex-wrap:wrap;gap:7px}
.pill{padding:8px 18px;border:1px solid #e0d4c8;border-radius:40px;font-size:13px;color:#7a6a60;cursor:pointer;transition:all .2s;background:#faf8f6;user-select:none}
.pill:hover{border-color:#c4a882;color:#2c2520}
.pill.on{background:#a07850;border-color:#a07850;color:#fff}

/* SCALE */
.scale-row{display:flex;gap:5px;flex-wrap:wrap;margin-top:4px}
.snum{width:38px;height:38px;border:1px solid #e0d4c8;background:#faf8f6;font-size:13px;color:#8a7a70;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;font-family:'Jost',sans-serif;user-select:none}
.snum:hover{border-color:#c4a882}
.snum.on{background:#a07850;border-color:#a07850;color:#fff}
.scale-labels{display:flex;justify-content:space-between;margin-top:5px;font-size:10px;color:#b0a090;letter-spacing:.04em}

/* FIELDSET BOX */
.fbox{border:1px solid #e8ddd4;padding:20px 22px;margin-bottom:20px;background:#fdf9f6}
.ftitle{font-size:10px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:#a07850;margin-bottom:14px}

/* NAV */
.nav{display:flex;justify-content:space-between;align-items:center;margin-top:40px;padding-top:28px;border-top:1px solid #e8ddd4}
.btn-back{background:none;border:1px solid #d4b896;color:#8a7a70;padding:11px 26px;font-family:'Jost',sans-serif;font-size:11px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:all .2s}
.btn-back:hover{border-color:#a07850;color:#a07850}
.btn-next{background:#2c2520;border:1px solid #2c2520;color:#f7f3ef;padding:13px 38px;font-family:'Jost',sans-serif;font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:all .2s}
.btn-next:hover{background:#a07850;border-color:#a07850}
.btn-submit{background:#a07850;border:1px solid #a07850;color:#fff;padding:13px 44px;font-family:'Jost',sans-serif;font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:all .2s}
.btn-submit:hover{background:#7a5c38;border-color:#7a5c38}

/* CONSENT */
.consent-box{border:1px solid #e0d4c8;padding:18px 22px;background:#fdf9f6;margin-top:8px}
.consent-title{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:400;color:#2c2520;margin-bottom:8px}
.consent-text{font-size:12px;color:#7a6a60;line-height:1.7;margin-bottom:14px}

/* SUCCESS */
.success{width:100%;max-width:700px;background:#fff;border:1px solid #e8ddd4;text-align:center;padding:80px 48px;position:relative;overflow:hidden;display:none}
.success::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#c4a882,#a07850,#7a5c38)}
.success-icon{font-size:48px;display:block;margin-bottom:24px}
.success-title{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:300;color:#2c2520;margin-bottom:10px}
.success-msg{font-size:14px;color:#8a7a70;font-weight:300;line-height:1.7;max-width:400px;margin:0 auto 28px}
.btn-reset{background:none;border:1px solid #d4b896;color:#a07850;padding:11px 30px;font-family:'Jost',sans-serif;font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:all .2s}
.btn-reset:hover{background:#a07850;color:#fff;border-color:#a07850}

/* HIDDEN STEPS */
.step-panel{display:none}
.step-panel.active{display:block}
</style>
</head>
<body>
<div class="root">

  <!-- HEADER -->
  <div class="header">
    <div class="badge">Ficha Anamnética Integrativa</div>
    <h1 class="title">Cuidar começa por <em>conhecer</em></h1>
    <p class="subtitle">Preencha com atenção — cada detalhe importa para o seu protocolo personalizado</p>
  </div>

  <!-- PROGRESS -->
  <div class="progress" id="progressBar">
    <div class="steps">
      <div class="step" onclick="goToStep(1)">
        <div class="dot active" id="dot1">✦</div>
        <span class="slabel active" id="sl1">Identificação</span>
      </div>
      <div class="step" onclick="goToStep(2)">
        <div class="dot" id="dot2">◈</div>
        <span class="slabel" id="sl2">Saúde Geral</span>
      </div>
      <div class="step" onclick="goToStep(3)">
        <div class="dot" id="dot3">◎</div>
        <span class="slabel" id="sl3">Pele & Estética</span>
      </div>
      <div class="step" onclick="goToStep(4)">
        <div class="dot" id="dot4">◇</div>
        <span class="slabel" id="sl4">Hábitos</span>
      </div>
      <div class="step" onclick="goToStep(5)">
        <div class="dot" id="dot5">❋</div>
        <span class="slabel" id="sl5">Integrativo</span>
      </div>
      <div class="step" onclick="goToStep(6)">
        <div class="dot" id="dot6">→</div>
        <span class="slabel" id="sl6">Objetivos</span>
      </div>
    </div>
  </div>

  <!-- CARD -->
  <div class="card" id="formCard">

    <!-- ── STEP 1 ── -->
    <div class="step-panel active" id="panel1">
      <div class="eyebrow"><span class="eicon">✦</span><span class="enum">Etapa 01 — 06</span></div>
      <h2 class="stitle">Identificação</h2>
      <p class="sdesc">Dados pessoais e informações de contato da cliente.</p>
      <div class="divider"></div>

      <div class="row2">
        <div class="fg"><label class="flabel">Nome completo <span class="req">*</span></label>
          <input type="text" id="nome" placeholder="Nome da cliente"></div>
        <div class="fg"><label class="flabel">Data de nascimento <span class="req">*</span></label>
          <input type="date" id="dataNasc"></div>
      </div>

      <div class="fg"><label class="flabel">Sexo biológico <span class="req">*</span></label>
        <div class="pills">
          <div class="pill" onclick="pill(this,'sexo')">Feminino</div>
          <div class="pill" onclick="pill(this,'sexo')">Masculino</div>
          <div class="pill" onclick="pill(this,'sexo')">Prefiro não informar</div>
        </div>
      </div>

      <div class="row2">
        <div class="fg"><label class="flabel">Profissão</label>
          <input type="text" id="profissao" placeholder="Ex: Professora"></div>
        <div class="fg"><label class="flabel">Telefone / WhatsApp</label>
          <input type="text" id="telefone" placeholder="(00) 00000-0000"></div>
      </div>

      <div class="fg"><label class="flabel">E-mail</label>
        <input type="email" id="email" placeholder="email@exemplo.com"></div>

      <div class="fg"><label class="flabel">Como nos conheceu?</label>
        <div class="pills">
          <div class="pill" onclick="pill(this,'indicacao')">Indicação</div>
          <div class="pill" onclick="pill(this,'indicacao')">Instagram</div>
          <div class="pill" onclick="pill(this,'indicacao')">Google</div>
          <div class="pill" onclick="pill(this,'indicacao')">TikTok</div>
          <div class="pill" onclick="pill(this,'indicacao')">Evento</div>
          <div class="pill" onclick="pill(this,'indicacao')">Outro</div>
        </div>
      </div>

      <div class="fg"><label class="flabel">É sua primeira vez aqui? <span class="req">*</span></label>
        <div class="pills">
          <div class="pill" onclick="pill(this,'primeiraVez')">Sim, primeira vez</div>
          <div class="pill" onclick="pill(this,'primeiraVez')">Já fui cliente antes</div>
        </div>
      </div>
    </div>

    <!-- ── STEP 2 ── -->
    <div class="step-panel" id="panel2">
      <div class="eyebrow"><span class="eicon">◈</span><span class="enum">Etapa 02 — 06</span></div>
      <h2 class="stitle">Saúde Geral</h2>
      <p class="sdesc">Histórico médico, medicamentos e condições relevantes para os procedimentos.</p>
      <div class="divider"></div>

      <div class="fg"><label class="flabel">Condições de saúde</label>
        <span class="fnote">Marque todas que se aplicam</span>
        <div class="check-grid" id="saude-grid">
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Diabetes</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Hipertensão</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Hipotensão</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Doenças cardíacas</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Doenças autoimunes</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Lúpus</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Vitiligo</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Psoríase</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Rosácea</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Dermatite atópica</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Herpes recorrente</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Epilepsia</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Câncer em tratamento</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Hipotireoidismo</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Hipertireoidismo</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Coagulopatias</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">HIV / Imunossupressão</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Enxaqueca crônica</span></div>
          <div class="ci" onclick="check(this,'saude')"><div class="cbox">✓</div><span class="ctext">Ansiedade / Depressão</span></div>
        </div>
        <input type="text" id="saude_outro" placeholder="Outra condição não listada..." style="margin-top:8px">
      </div>

      <div class="fg"><label class="flabel">Usa algum medicamento atualmente?</label>
        <span class="fnote">Inclua suplementos, fitoterápicos e hormônios</span>
        <textarea id="medicamentos" placeholder="Ex: Roacutan 20mg, anticoncepcional oral (Yaz), vitamina D..."></textarea>
      </div>

      <div class="row2">
        <div class="fg"><label class="flabel">Alergias conhecidas</label>
          <input type="text" id="alergias" placeholder="Ex: dipirona, látex, fragrâncias..."></div>
        <div class="fg"><label class="flabel">Cirurgias / procedimentos recentes</label>
          <input type="text" id="cirurgias" placeholder="Ex: rinoplastia há 6 meses"></div>
      </div>

      <div class="fbox">
        <p class="ftitle">Para clientes do sexo feminino</p>
        <div class="row2">
          <div class="fg"><label class="flabel">Está gestante?</label>
            <div class="pills">
              <div class="pill" onclick="pill(this,'gestante')">Sim</div>
              <div class="pill" onclick="pill(this,'gestante')">Não</div>
              <div class="pill" onclick="pill(this,'gestante')">Suspeita</div>
            </div>
          </div>
          <div class="fg"><label class="flabel">Está amamentando?</label>
            <div class="pills">
              <div class="pill" onclick="pill(this,'amamentando')">Sim</div>
              <div class="pill" onclick="pill(this,'amamentando')">Não</div>
            </div>
          </div>
        </div>
        <div class="fg"><label class="flabel">Usa anticoncepcional?</label>
          <div class="pills">
            <div class="pill" onclick="pill(this,'anticoncepcional')">Não</div>
            <div class="pill" onclick="pill(this,'anticoncepcional')">Oral</div>
            <div class="pill" onclick="pill(this,'anticoncepcional')">Injetável</div>
            <div class="pill" onclick="pill(this,'anticoncepcional')">DIU hormonal</div>
            <div class="pill" onclick="pill(this,'anticoncepcional')">Implante</div>
          </div>
        </div>
        <div class="fg"><label class="flabel">Faz reposição hormonal?</label>
          <div class="pills">
            <div class="pill" onclick="pill(this,'hormonal')">Sim</div>
            <div class="pill" onclick="pill(this,'hormonal')">Não</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── STEP 3 ── -->
    <div class="step-panel" id="panel3">
      <div class="eyebrow"><span class="eicon">◎</span><span class="enum">Etapa 03 — 06</span></div>
      <h2 class="stitle">Pele & Estética</h2>
      <p class="sdesc">Avaliação do tipo de pele, queixas e histórico de tratamentos.</p>
      <div class="divider"></div>

      <div class="fbox">
        <p class="ftitle">Características da pele</p>
        <div class="row2">
          <div class="fg"><label class="flabel">Tipo de pele (autopercepção)</label>
            <div class="pills">
              <div class="pill" onclick="pill(this,'tipoPele')">Normal</div>
              <div class="pill" onclick="pill(this,'tipoPele')">Seca</div>
              <div class="pill" onclick="pill(this,'tipoPele')">Oleosa</div>
              <div class="pill" onclick="pill(this,'tipoPele')">Mista</div>
              <div class="pill" onclick="pill(this,'tipoPele')">Não sei</div>
            </div>
          </div>
          <div class="fg"><label class="flabel">Sensibilidade</label>
            <div class="pills">
              <div class="pill" onclick="pill(this,'sensibilidade')">Pouca</div>
              <div class="pill" onclick="pill(this,'sensibilidade')">Moderada</div>
              <div class="pill" onclick="pill(this,'sensibilidade')">Alta</div>
              <div class="pill" onclick="pill(this,'sensibilidade')">Reativa</div>
            </div>
          </div>
        </div>
        <div class="fg"><label class="flabel">Fototipo (Fitzpatrick)</label>
          <span class="fnote">Aproximado — será avaliado na consulta</span>
          <div class="pills">
            <div class="pill" onclick="pill(this,'fototipo')">I</div>
            <div class="pill" onclick="pill(this,'fototipo')">II</div>
            <div class="pill" onclick="pill(this,'fototipo')">III</div>
            <div class="pill" onclick="pill(this,'fototipo')">IV</div>
            <div class="pill" onclick="pill(this,'fototipo')">V</div>
            <div class="pill" onclick="pill(this,'fototipo')">VI</div>
          </div>
        </div>
      </div>

      <div class="fg"><label class="flabel">Principais queixas estéticas</label>
        <span class="fnote">Marque todas as que deseja tratar</span>
        <div class="check-grid">
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Acne / comedões</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Manchas (melasma)</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Manchas pós-inflamatórias</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Poros dilatados</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Rugas finas</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Flacidez facial</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Flacidez corporal</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Celulite</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Estrias</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Olheiras</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Pele opaca / sem viço</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Ressecamento intenso</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Sensibilidade / vermelhidão</span></div>
          <div class="ci" onclick="check(this,'queixa')"><div class="cbox">✓</div><span class="ctext">Hiperidrose</span></div>
